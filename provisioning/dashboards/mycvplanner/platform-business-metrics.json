        {
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "platform-sqlite"
          },
          "queryType": "table",
          "rawQueryText": "WITH RECURSIVE\n  bounds AS (\n    SELECT MIN(day) AS start_day\n    FROM (\n      SELECT DATE(created_at) AS day FROM home_purchaserecord\n    )\n  ),\n  calendar(day) AS (\n    SELECT COALESCE((SELECT start_day FROM bounds), DATE('now'))\n    UNION ALL\n    SELECT DATE(day, '+1 day')\n    FROM calendar\n    WHERE day < DATE('now')\n  )\nSELECT\n  calendar.day || 'T00:00:00Z' AS time,\n  COUNT(*) AS \"Active users (sum)\"\nFROM calendar\nJOIN home_purchaserecord AS purchase\n  ON purchase.status = 'completed'\n  AND purchase.price_chf > 0\n  AND DATE(purchase.created_at) <= calendar.day\n  AND (purchase.billing_cycle = 'one-time' OR purchase.cancelled_at IS NULL OR DATE(purchase.cancelled_at) > calendar.day)\nGROUP BY calendar.day\nORDER BY time ASC;",
          "queryText": "WITH RECURSIVE\n  bounds AS (\n    SELECT MIN(day) AS start_day\n    FROM (\n      SELECT DATE(created_at) AS day FROM home_purchaserecord\n    )\n  ),\n  calendar(day) AS (\n    SELECT COALESCE((SELECT start_day FROM bounds), DATE('now'))\n    UNION ALL\n    SELECT DATE(day, '+1 day')\n    FROM calendar\n    WHERE day < DATE('now')\n  )\nSELECT\n  calendar.day || 'T00:00:00Z' AS time,\n  COUNT(*) AS \"Active users (sum)\"\nFROM calendar\nJOIN home_purchaserecord AS purchase\n  ON purchase.status = 'completed'\n  AND purchase.price_chf > 0\n  AND DATE(purchase.created_at) <= calendar.day\n  AND (purchase.billing_cycle = 'one-time' OR purchase.cancelled_at IS NULL OR DATE(purchase.cancelled_at) > calendar.day)\nGROUP BY calendar.day\nORDER BY time ASC;",
          "timeColumns": [
            "time"
          ],
          "refId": "A"
        }
      ],
      "title": "Active users over time",
      "type": "timeseries"
    },
